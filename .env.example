# Copy to .env for local development. In development and test, everything
# except the third-party keys has a working local default.
APP_ENV=development
SITE_URL=http://localhost:4321

# Supabase (`pnpm supabase status` prints the local values)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random characters each (e.g. `openssl rand -base64 48`)
APP_SECRET=
CRON_SECRET=

# Stripe (test keys first). Webhook secret from `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="calenda11y <hello@calenda11y.org>"

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional import credentials
LUMA_API_KEY=
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=

# Place search for "near me" (OpenStreetMap Nominatim by default). Follow its
# usage policy: https://operations.osmfoundation.org/policies/nominatim/
# Point this at another Nominatim-compatible service, or set GEOCODER_OFF=1.
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_OFF=0
