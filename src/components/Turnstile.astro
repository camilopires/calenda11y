---
// Cloudflare Turnstile in managed mode: usually invisible, never a puzzle.
// If it can't run (no JavaScript, blocked), the form still works.
import { captcha } from '../lib/services/captcha';

interface Props {
  action: string;
}
const { action } = Astro.props;
const siteKey = captcha().siteKey;
---

{siteKey && (
  <>
    <div
      class="cf-turnstile"
      data-sitekey={siteKey}
      data-action={action}
      data-appearance="interaction-only"
      data-language="en"
    />
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  </>
)}
