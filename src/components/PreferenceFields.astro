---
import ChoiceGroup from './ChoiceGroup.astro';
import { shownUnit } from '../lib/geo/distance';
import { NEAR_MAX } from '../lib/geo/place';
import Field from './Field.astro';
import type { FieldErrors } from '../lib/forms/errors';
import type { PreferenceValues } from '../lib/digest/form';
import {
  EVENT_TOPICS,
  EVENT_TYPES,
  FORMAT_LABELS,
  FORMATS,
  TOPIC_LABELS,
  TOPIC_SLUGS,
  TYPE_LABELS,
} from '../lib/events/model';
import { allCountries } from '../lib/events/countries';

interface Props {
  values: PreferenceValues;
  errors: FieldErrors;
  /** "Which Medway?" choices, when a typed place matched several. */
  placeChoices?: Array<{ value: string; label: string }> | undefined;
}
const { values: v, errors: e, placeChoices } = Astro.props;
const placed = !!v.near && !!v.nearAt && v.nearFrom === v.near;
const unitWord = shownUnit(placed, v.nearUnit) === 'km' ? 'km' : 'miles';
const countries = await allCountries();
---

<ChoiceGroup
  name="cadence"
  legend="How often?"
  type="radio"
  required
  value={v.cadence}
  error={e.cadence}
  options={[
    { value: 'weekly', label: 'Weekly', hint: "On Mondays, with that week's events." },
    { value: 'monthly', label: 'Monthly', hint: "On the 1st, with that month's events." },
    { value: 'daily', label: 'Daily', hint: 'Each morning, with events added or changed since the day before.' },
    {
      value: 'instant',
      label: 'As they happen',
      hint: 'Within about 10 minutes of an event being added or changed. At most one email every 10 minutes.',
    },
  ]}
/>
<Field
  name="country"
  label="Country"
  type="select"
  value={v.country}
  error={e.country}
  hint="Leave as 'Everywhere' to get events from every country."
  showOptional={false}
  options={[{ value: '', label: 'Everywhere' }, ...countries.map((c) => ({ value: c.code, label: c.name }))]}
/>
<div class="choice">
  <input type="checkbox" id="f-online" name="online" checked={v.online} />
  <label for="f-online">Also include events I can join online</label>
</div>
<ChoiceGroup
  name="format"
  legend="Only these formats"
  hint="Leave all unticked for every format."
  type="checkbox"
  inline
  value={v.formats}
  error={e.format}
  options={FORMATS.map((f) => ({ value: f, label: FORMAT_LABELS[f] }))}
/>
<ChoiceGroup
  name="type"
  legend="Only these types of event"
  hint="Leave all unticked to get every type."
  type="checkbox"
  inline
  value={v.types}
  error={e.type}
  options={EVENT_TYPES.map((t) => ({ value: t, label: TYPE_LABELS[t] }))}
/>
<Field
  name="near"
  label="Near"
  value={v.near}
  error={e.near}
  maxlength={NEAR_MAX}
  hint="A town, city or postcode. Leave blank for anywhere."
/>
{placeChoices && (
  <ChoiceGroup
    name="near_pick"
    legend={`Which ${v.near}?`}
    hint="We found more than one place with that name."
    type="radio"
    required
    error={e.near_pick}
    options={placeChoices}
  />
)}
{placed && (
  <>
    <input type="hidden" name="near_from" value={v.near} />
    <input type="hidden" name="near_at" value={v.nearAt} />
    <input type="hidden" name="near_u" value={v.nearUnit} />
  </>
)}
<Field
  name="near_within"
  label="Within"
  type="select"
  value={v.nearWithin || '25'}
  error={e.near_within}
  hint="Used only if you choose a place."
  showOptional={false}
  options={[10, 25, 50, 100].map((r) => ({ value: String(r), label: `${r} ${unitWord}` }))}
/>
<div class="choice">
  <input type="checkbox" id="f-near_online" name="near_online" checked={v.nearOnline} />
  <label for="f-near_online">With a place, also include online events</label>
</div>
<ChoiceGroup
  name="topic"
  legend="Only these topics"
  hint="Leave all unticked for every topic."
  type="checkbox"
  inline
  value={v.topics}
  error={e.topic}
  options={EVENT_TOPICS.map((t) => ({ value: TOPIC_SLUGS[t], label: TOPIC_LABELS[t] }))}
/>
<div class="choice">
  <input
    type="checkbox"
    id="f-include_cfp"
    name="include_cfp"
    checked={v.include_cfp}
    aria-describedby="f-include_cfp-hint"
  />
  <label for="f-include_cfp">Also tell me about calls for speakers</label>
</div>
<p class="hint" id="f-include_cfp-hint">
  Calls closing in the next few weeks, even for events later in the year.
</p>
