---
import ChoiceGroup from './ChoiceGroup.astro';
import Field from './Field.astro';
import type { FieldErrors } from '../lib/forms/errors';
import type { PreferenceValues } from '../lib/digest/form';
import {
  EVENT_TOPICS,
  EVENT_TYPES,
  FORMAT_LABELS,
  FORMATS,
  TOPIC_LABELS,
  TOPIC_SLUGS,
  TYPE_LABELS,
} from '../lib/events/model';
import { allCountries } from '../lib/events/countries';

interface Props {
  values: PreferenceValues;
  errors: FieldErrors;
}
const { values: v, errors: e } = Astro.props;
const countries = await allCountries();
---

<ChoiceGroup
  name="cadence"
  legend="How often?"
  type="radio"
  required
  value={v.cadence}
  error={e.cadence}
  options={[
    { value: 'weekly', label: 'Weekly', hint: "On Mondays, with that week's events." },
    { value: 'monthly', label: 'Monthly', hint: "On the 1st, with that month's events." },
    { value: 'daily', label: 'Daily', hint: 'Each morning, with events added or changed since the day before.' },
    {
      value: 'instant',
      label: 'As they happen',
      hint: 'Within about 10 minutes of an event being added or changed. At most one email every 10 minutes.',
    },
  ]}
/>
<Field
  name="country"
  label="Country"
  type="select"
  value={v.country}
  error={e.country}
  hint="Leave as 'Everywhere' to get events from every country."
  showOptional={false}
  options={[{ value: '', label: 'Everywhere' }, ...countries.map((c) => ({ value: c.code, label: c.name }))]}
/>
<div class="choice">
  <input type="checkbox" id="f-online" name="online" checked={v.online} />
  <label for="f-online">Also include events I can join online</label>
</div>
<ChoiceGroup
  name="format"
  legend="Only these formats"
  hint="Leave all unticked for every format."
  type="checkbox"
  inline
  value={v.formats}
  error={e.format}
  options={FORMATS.map((f) => ({ value: f, label: FORMAT_LABELS[f] }))}
/>
<ChoiceGroup
  name="type"
  legend="Only these types of event"
  hint="Leave all unticked to get every type."
  type="checkbox"
  inline
  value={v.types}
  error={e.type}
  options={EVENT_TYPES.map((t) => ({ value: t, label: TYPE_LABELS[t] }))}
/>
<ChoiceGroup
  name="topic"
  legend="Only these topics"
  hint="Leave all unticked for every topic."
  type="checkbox"
  inline
  value={v.topics}
  error={e.topic}
  options={EVENT_TOPICS.map((t) => ({ value: TOPIC_SLUGS[t], label: TOPIC_LABELS[t] }))}
/>
<div class="choice">
  <input
    type="checkbox"
    id="f-include_cfp"
    name="include_cfp"
    checked={v.include_cfp}
    aria-describedby="f-include_cfp-hint"
  />
  <label for="f-include_cfp">Also tell me about calls for speakers</label>
</div>
<p class="hint" id="f-include_cfp-hint">
  Calls closing in the next few weeks, even for events later in the year.
</p>
