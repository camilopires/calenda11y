---
import Field from './Field.astro';
import ChoiceGroup from './ChoiceGroup.astro';
import type { FieldErrors } from '../lib/forms/errors';
import {
  ACCESS_LABELS,
  ACCESS_PROVISIONS,
  EVENT_TOPICS,
  EVENT_TYPES,
  FORMAT_LABELS,
  FORMATS,
  TOPIC_LABELS,
  TOPIC_SLUGS,
  TYPE_LABELS,
  countryName,
  topicFromSlug,
} from '../lib/events/model';
import { formatMonthYear, isIsoMonth, monthOptions, todayUtc } from '../lib/events/dates';
import { RADII } from '../lib/geo/distance';
import type { CountryCount } from '../lib/events/query';
import type { FilterValues } from '../lib/events/predicates';

interface Props {
  values: FilterValues;
  errors: FieldErrors;
  countries: CountryCount[];
  /** The list has date filters; the month grid is already limited to a month. */
  mode: 'list' | 'grid';
  action: string;
  month?: string;
  past?: boolean;
}
const { values, errors, countries, mode, action, month, past = false } = Astro.props;

const known = new Map(countries.map((c) => [c.country_code, c.upcoming]));
const selectedCountry = values.country.toUpperCase();
if (
  selectedCountry &&
  selectedCountry !== 'ONLINE' &&
  !known.has(selectedCountry) &&
  /^[A-Z]{2}$/.test(selectedCountry)
) {
  known.set(selectedCountry, 0);
}
const countryOptions = [
  { value: '', label: 'Any country' },
  { value: 'online', label: 'Online, from anywhere' },
  ...[...known.entries()]
    .map(([code, n]) => ({ value: code, label: `${countryName(code)} (${n} upcoming)` }))
    .sort((a, b) => a.label.localeCompare(b.label, 'en')),
];
const countryValue = values.country.toLowerCase() === 'online' ? 'online' : selectedCountry;
// A chosen month ignores leftover dates, so they don't open "More filters" either.
const monthChosen = isIsoMonth(values.range);
const moreActive = [
  values.topics.length,
  errors.topic,
  values.access.length,
  !monthChosen && values.from,
  !monthChosen && values.to,
  errors.access,
  errors.from,
  errors.to,
  values.range === 'custom',
].some(Boolean);
// Topics count once each, whichever spelling the link used.
const chosenTopics = new Set(values.topics.filter((t) => topicFromSlug(t)));
const moreCount =
  chosenTopics.size +
  values.access.length +
  (!monthChosen && values.from ? 1 : 0) +
  (!monthChosen && values.to ? 1 : 0);

// "Within" reads in the place's unit; miles until a place says otherwise.
const unitWord = values.unit === 'km' && values.at ? 'km' : 'miles';
const nearResolved = !!values.near && !!values.at && !errors.near;

// This month and the next 11 (or the previous 11 for past events). A month
// from a shared link that isn't in the list is added, so the select shows it.
const months = monthOptions(todayUtc(), past);
if (monthChosen && !months.some((m) => m.value === values.range)) {
  months.push({ value: values.range, label: formatMonthYear(values.range) });
}
---

<form class="filters" method="get" action={action} role="search" aria-label="Filter events">
  {month && <input type="hidden" name="month" value={month} />}
  {past && <input type="hidden" name="when" value="past" />}
  <div class="filters__grid">
    <Field
      name="q"
      label="Search"
      type="search"
      value={values.q}
      error={errors.q}
      maxlength={100}
      showOptional={false}
    />
    <Field
      name="country"
      label="Country"
      type="select"
      value={countryValue}
      error={errors.country}
      options={countryOptions}
      showOptional={false}
    />
    {mode === 'list' && (
      <Field
        name="range"
        label="When"
        type="select"
        value={values.range || 'upcoming'}
        error={errors.range}
        showOptional={false}
        options={[
          { value: 'upcoming', label: past ? 'Any past date' : 'Any upcoming date' },
          { value: 'this-month', label: 'The rest of this month' },
          { value: '3-months', label: 'The next 3 months' },
          { value: 'custom', label: 'Dates I choose' },
        ]}
        groups={[{ label: 'Months', options: months }]}
      />
    )}
    <Field
      name="price"
      label="Price"
      type="select"
      value={values.price}
      error={errors.price}
      showOptional={false}
      options={[
        { value: '', label: 'Free or paid' },
        { value: 'free', label: 'Free' },
        { value: 'paid', label: 'Paid' },
      ]}
    />
    <Field
      name="near"
      label="Near"
      type="search"
      value={values.near}
      error={errors.near}
      maxlength={100}
      hint="A town, city or postcode"
      showOptional={false}
    />
    <Field
      name="within"
      label="Within"
      type="select"
      value={values.within || (values.near ? '25' : '')}
      error={errors.within}
      showOptional={false}
      options={[
        // Without a place there's nothing to measure from.
        ...(values.near ? [] : [{ value: '', label: 'Any distance' }]),
        ...RADII.map((r) => ({ value: String(r), label: `${r} ${unitWord}` })),
      ]}
    />
  </div>
  {/* The place the search was last looked up from, so an edited "Near" is looked up again and a resubmit isn't. */}
  {nearResolved && (
    <>
      <input type="hidden" name="at" value={values.at} />
      <input type="hidden" name="u" value={values.unit} />
      <input type="hidden" name="near_from" value={values.near} />
    </>
  )}
  {values.near && (
    <div class="choice">
      <input type="checkbox" id="f-online-include" name="online" value="include" checked={values.includeOnline} />
      <label for="f-online-include">Also show online events</label>
    </div>
  )}

  <div class="filters__kinds">
    <ChoiceGroup
      name="format"
      legend="Format"
      type="checkbox"
      inline
      value={values.formats}
      error={errors.format}
      options={FORMATS.map((f) => ({ value: f, label: FORMAT_LABELS[f] }))}
    />
    <ChoiceGroup
      name="type"
      legend="Type"
      type="checkbox"
      inline
      value={values.types}
      error={errors.type}
      options={EVENT_TYPES.map((t) => ({ value: t, label: TYPE_LABELS[t] }))}
    />
    <ChoiceGroup
      name="cfp"
      legend="Speaking"
      type="checkbox"
      value={values.cfp ? ['open'] : []}
      error={errors.cfp}
      options={[{ value: 'open', label: 'Open for speakers' }]}
    />
  </div>

  <details class="filters__more" open={moreActive}>
    <summary>More filters{moreCount > 0 && <>: {moreCount} chosen</>}</summary>
    {mode === 'list' && (
      <fieldset>
        <legend class="label">Dates</legend>
        <div class="filters__grid filters__grid--pair">
          <Field name="from" label="From" type="date" value={values.from} error={errors.from} />
          <Field name="to" label="To" type="date" value={values.to} error={errors.to} />
        </div>
      </fieldset>
    )}
    <ChoiceGroup
      name="topic"
      legend="Topic"
      type="checkbox"
      inline
      value={values.topics}
      error={errors.topic}
      options={EVENT_TOPICS.map((t) => ({ value: TOPIC_SLUGS[t], label: TOPIC_LABELS[t] }))}
    />
    <ChoiceGroup
      name="access"
      legend="Access provisions"
      hint="Only show events that have all of these."
      type="checkbox"
      inline
      value={values.access}
      error={errors.access}
      options={ACCESS_PROVISIONS.map((a) => ({ value: a, label: ACCESS_LABELS[a] }))}
    />
  </details>

  <div class="button-row filters__actions">
    <button type="submit">Show events</button>
    <a class="link-standalone" href={month ? `${action}?month=${month}` : past ? `${action}?when=past` : action}>
      Clear filters
    </a>
  </div>
</form>
