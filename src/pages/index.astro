---
import BaseLayout from '../layouts/BaseLayout.astro';
import ErrorSummary from '../components/ErrorSummary.astro';
import EventList from '../components/EventList.astro';
import FilterForm from '../components/FilterForm.astro';
import Pagination from '../components/Pagination.astro';
import TimeZoneToggle from '../components/TimeZoneToggle.astro';
import { t } from '../i18n/t';
import { TYPE_PLURALS, countryName } from '../lib/events/model';
import { formatMonthYear } from '../lib/events/dates';
import { aboutTopics, filtersToParams, parseFilters, withinWords, ONLINE } from '../lib/events/predicates';
import { formatDistance, haversineKm } from '../lib/geo/distance';
import { resolveNear } from '../lib/geo/resolve';
import { clientIp } from '../lib/security/ratelimit';
import PlaceChoices from '../components/PlaceChoices.astro';
import { countryCounts, listEvents } from '../lib/events/query';

const parsed = parseFilters(Astro.url.searchParams);
const { filters, values, active } = parsed;
const errors = { ...parsed.errors };
// A typed place is looked up here (once; then it's in the link).
let choices: Array<{ label: string; href: string }> | undefined;
if (parsed.lookup) {
  const r = await resolveNear(parsed.lookup, Astro.url, clientIp(Astro.request, Astro.clientAddress));
  if (r.kind === 'redirect') return Astro.redirect(r.href, 303);
  if (r.kind === 'choose') choices = r.choices;
  else errors.near = r.message;
}
const [result, countries] = await Promise.all([listEvents(filters), countryCounts()]);
const near = filters.near;
const distance = near
  ? (e: { lat: number | null; lng: number | null; format: string }) =>
      e.format !== 'online' && e.lat !== null && e.lng !== null
        ? `${formatDistance(haversineKm(near, { lat: e.lat, lng: e.lng }), near.unit)} away`
        : undefined
  : undefined;
const past = filters.when === 'past';

const pageHref = (n: number) => {
  const qs = filtersToParams(filters, { page: n }).toString();
  return qs ? `/?${qs}` : '/';
};
const feedQuery = filtersToParams(filters, { includePage: false });
feedQuery.delete('when');
const feedQs = feedQuery.toString();

const where =
  filters.country === ONLINE ? ' you can join online' : filters.country ? ` in ${countryName(filters.country)}` : '';
const kind = filters.when === 'any' ? '' : past ? 'past ' : 'upcoming ';
// "conferences or workshops" when types are chosen; one result is just "event".
const plural = filters.types.length ? filters.types.map((ty) => TYPE_PLURALS[ty]).join(' or ') : 'events';
const inMonth = filters.range === 'month' && filters.month ? ` in ${formatMonthYear(filters.month)}` : '';
const speaking = filters.cfp ? ' with an open call for speakers' : '';
const nearWords = near ? ` ${withinWords(near)}` : '';
const about = filters.topics.length ? ` ${aboutTopics(filters.topics)}` : '';
const countText =
  result.total === 0
    ? `No ${kind}${plural} found${about}${where}${nearWords}${inMonth}${speaking}`
    : `${result.total} ${kind}${result.total === 1 ? 'event' : plural}${about}${where}${nearWords}${inMonth}${speaking}` +
      (result.pages > 1 ? `. Page ${result.page} of ${result.pages}` : '');
---

<BaseLayout
  hasErrors={Object.keys(errors).length > 0}
  title={past ? 'Past accessibility events' : t('site.tagline')}
  nav="events"
  isHome={!past}
  crumbLabel="Past events"
>
  <div class="page-head">
    <h1>{past ? 'Past accessibility events' : t('site.tagline')}</h1>
    <p class="lede">
      {past
        ? 'Events that have already happened.'
        : 'Conferences, meetups and workshops about digital accessibility, checked by a person before they appear.'}
    </p>
  </div>

  <ErrorSummary errors={errors} targets={{ format: 'f-format', access: 'f-access' }} />

  {choices && <PlaceChoices near={values.near} choices={choices} />}

  <FilterForm values={values} errors={errors} countries={countries} mode="list" action="/" past={past} />

  <div class="results-bar">
    <p
      id="results-count"
      tabindex="-1"
      data-focus-on-load={active && Object.keys(errors).length === 0 && !choices ? '' : undefined}
    >
      <strong>{countText}</strong>
    </p>
    <p class="small">
      {past ? (
        <a class="link-standalone" href="/">
          See upcoming events
        </a>
      ) : (
        <>
          <a href={`/subscribe${feedQs ? `?${feedQs}` : ''}`}>Subscribe to these events</a> or{' '}
          <a href={`/calendar${feedQs ? `?${feedQs}` : ''}`}>see them on a month calendar</a>
        </>
      )}
    </p>
  </div>

  {near && (
    <p class="small">
      Place search by <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>.
    </p>
  )}

  {result.events.length > 0 && <TimeZoneToggle />}

  {result.events.length > 0 ? (
    <EventList events={result.events} distance={distance} />
  ) : (
    <div class="notice flow-tight">
      <p>Try fewer filters, or search for a different word.</p>
      <p>
        Know about an event that's missing? <a href="/submit">Add an event to calenda11y</a>.
      </p>
    </div>
  )}

  <Pagination page={result.page} pages={result.pages} href={pageHref} />

  {!past && (
    <p class="small">
      <a class="link-standalone" href="/?when=past">
        See past events
      </a>
    </p>
  )}
</BaseLayout>
