---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { requireAdmin } from '../../lib/admin/auth';
import { ADMIN_PAGE_SIZE, QUEUE_VIEWS, listQueue, queueCounts, type QueueView } from '../../lib/admin/events';
import { describeWhen } from '../../lib/events/dates';
import { countryName } from '../../lib/events/model';

const guard = await requireAdmin(Astro);
if (!guard.ok) return guard.response;

const FLAG_LABELS: Record<string, string> = {
  possible_duplicate: 'Possible duplicate',
  changed: 'Changed by source',
  missing_from_source: 'Missing from source',
  captcha_unverified: 'Spam check not passed',
  cancel_requested: 'Source says cancelled',
};
const requested = Astro.url.searchParams.get('view') ?? 'pending';
const view: QueueView = requested in QUEUE_VIEWS ? (requested as QueueView) : 'pending';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const [{ events, total }, counts] = await Promise.all([listQueue(view, page), queueCounts()]);
const pages = Math.ceil(total / ADMIN_PAGE_SIZE);
const notice = Astro.url.searchParams.get('done');
const notices: Record<string, string> = {
  approved: 'Event published.',
  rejected: 'Event rejected. We emailed the person who added it.',
  unpublished: 'Event taken off the site. It is waiting for review again.',
  cancelled: 'Event marked as cancelled.',
  bulk: 'Events published.',
};
const canBulk = view === 'pending' && events.length > 0;
---

<AdminLayout title="Events" admin={guard.admin} current="queue" isRoot>
  <div class="page-head">
    <h1>Events</h1>
  </div>

  {notice && notices[notice] && (
    <div class="notice notice--success" role="status" tabindex="-1" data-focus-on-load>
      <p>
        {notices[notice]}
        {notice === 'bulk' && Astro.url.searchParams.get('n') ? ` ${Astro.url.searchParams.get('n')} published.` : ''}
      </p>
    </div>
  )}

  <nav aria-label="Event lists" class="view-tabs">
    {(Object.keys(QUEUE_VIEWS) as QueueView[]).map((v) => (
      <a href={`/admin?view=${v}`} aria-current={v === view ? 'page' : undefined}>
        {QUEUE_VIEWS[v]} ({counts[v]})
      </a>
    ))}
  </nav>

  <h2>{QUEUE_VIEWS[view]}</h2>

  {events.length === 0 ? (
    <p>There are no events here.</p>
  ) : (
    <form method="post" action="/admin/bulk">
      {/* A scrollable region must be focusable so keyboard users can scroll it. */}
      {/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex */}
      <section class="table-scroll" aria-labelledby="queue-caption" tabindex="0">
        <table class="data-table">
          <caption id="queue-caption" class="visually-hidden">
            {QUEUE_VIEWS[view]}, {total} {total === 1 ? 'event' : 'events'}
          </caption>
          <thead>
            <tr>
              {canBulk && <th scope="col">Select</th>}
              <th scope="col">Event</th>
              <th scope="col">When</th>
              <th scope="col">Where</th>
              <th scope="col">Source</th>
              <th scope="col">Flags</th>
            </tr>
          </thead>
          <tbody>
            {events.map((e) => {
              const when = describeWhen(e);
              return (
                <tr>
                  {canBulk && (
                    <td>
                      <input
                        type="checkbox"
                        name="event"
                        value={`${e.id}:${e.version}`}
                        id={`sel-${e.id}`}
                        aria-labelledby={`sel-${e.id}-label`}
                      />
                    </td>
                  )}
                  <th scope="row">
                    <a href={`/admin/events/${e.id}`} id={`sel-${e.id}-label`} lang={e.lang}>
                      {e.title}
                    </a>
                  </th>
                  <td>{when.date}</td>
                  <td>
                    {e.format === 'online'
                      ? 'Online'
                      : `${e.city ?? ''}${e.country_code ? `, ${countryName(e.country_code)}` : ''}`}
                  </td>
                  <td>{e.source === 'form' ? 'Form' : e.source.toUpperCase()}</td>
                  <td>{e.flags.length ? e.flags.map((f) => FLAG_LABELS[f] ?? f).join(', ') : 'None'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
      {canBulk && (
        <div class="button-row filters__actions">
          <button type="submit" name="step" value="check">
            Publish selected events
          </button>
          <span class="hint">You'll be able to check the list before anything is published.</span>
        </div>
      )}
    </form>
  )}

  <Pagination page={page} pages={pages} href={(n) => `/admin?view=${view}&page=${n}`} />
</AdminLayout>
