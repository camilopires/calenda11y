---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Abbreviated from '../../../components/Abbreviated.astro';
import ErrorSummary from '../../../components/ErrorSummary.astro';
import EventFields from '../../../components/EventFields.astro';
import Field from '../../../components/Field.astro';
import { requireAdmin, takeDraft } from '../../../lib/admin/auth';
import {
  NeedsTypeError,
  VersionConflict,
  getAdminEvent,
  moderate,
  saveEvent,
  type ModerationAction,
} from '../../../lib/admin/events';
import { acceptPendingChanges, discardPendingChanges } from '../../../lib/imports/upsert';
import { describeWhen } from '../../../lib/events/dates';
import { readEventForm, recordToForm, validateEvent, type EventFormValues } from '../../../lib/forms/event';
import { ServiceError } from '../../../lib/result';
import type { FieldErrors } from '../../../lib/forms/errors';

const guard = await requireAdmin(Astro, { keepDraft: true });
if (!guard.ok) return guard.response;
const id = Astro.params.id ?? '';
let detail = await getAdminEvent(id);
if (!detail) return Astro.rewrite('/404');

let values: EventFormValues = recordToForm(detail.event);
let version = detail.event.version;
let errors: FieldErrors = {};
const general: string[] = [];
let view: 'detail' | 'reject' = 'detail';
let rejectReason = '';
let restored = false;
let restoredStep = '';
const saved = Astro.url.searchParams.get('saved') === '1';

const done: Record<ModerationAction, string> = {
  approve: 'approved',
  reject: 'rejected',
  unpublish: 'unpublished',
  cancel: 'cancelled',
  restore: 'approved',
};

let form = guard.form;
if (!form && Astro.request.method === 'GET') {
  // Restore what the admin had typed if their session expired while saving.
  form = await takeDraft(Astro);
  restored = form !== null;
}

if (form) {
  const step = String(form.get('step') ?? '');
  const sentVersion = Number(form.get('version'));
  try {
    if (restored) {
      restoredStep = step;
      // Put back what the admin was doing: an edit, or a rejection with its reason.
      // Nothing is saved until they choose to again.
      version = Number.isInteger(sentVersion) && sentVersion > 0 ? sentVersion : version;
      if (step === 'save') values = readEventForm(form);
      else if (step === 'reject') {
        view = 'reject';
        rejectReason = String(form.get('reason') ?? '');
      }
    } else if (step === 'save') {
      values = readEventForm(form);
      const result = validateEvent(values, { now: new Date(), allowPast: true });
      if (!result.ok) errors = result.errors;
      else {
        await saveEvent(detail.event.id, sentVersion, result.record);
        return Astro.redirect(`/admin/events/${detail.event.id}?saved=1`, 303);
      }
    } else if (step === 'accept-changes' || step === 'discard-changes') {
      let ok: boolean;
      try {
        ok =
          step === 'accept-changes'
            ? await acceptPendingChanges(detail.event.id, sentVersion)
            : await discardPendingChanges(detail.event.id, sentVersion);
      } catch (err) {
        if (!(err instanceof ServiceError)) throw err;
        // For example the source's new details break a rule (an end before the start).
        console.error('[admin] applying source changes failed', err);
        general.push(
          `These changes can't be applied as they are (${err.message}). Edit the details below instead, then choose "Keep the current details".`,
        );
        ok = true;
      }
      if (!ok) throw new VersionConflict();
      if (!general.length) return Astro.redirect(`/admin/events/${detail.event.id}?saved=1`, 303);
    } else if (step === 'reject-check') {
      view = 'reject';
    } else if (step === 'reject') {
      rejectReason = String(form.get('reason') ?? '').trim();
      if (!rejectReason) {
        view = 'reject';
        errors = { reason: 'Enter why the event is not being published. We send this to the person who added it.' };
      } else if (rejectReason.length > 2000) {
        view = 'reject';
        errors = { reason: 'The reason must be 2,000 characters or fewer' };
      } else {
        await moderate(detail, 'reject', sentVersion, rejectReason);
        return Astro.redirect('/admin?done=rejected', 303);
      }
    } else if (step === 'approve' || step === 'unpublish' || step === 'cancel' || step === 'restore') {
      await moderate(detail, step, sentVersion);
      return Astro.redirect(
        step === 'restore' ? `/admin/events/${detail.event.id}?saved=1` : `/admin?done=${done[step]}`,
        303,
      );
    }
  } catch (err) {
    if (err instanceof NeedsTypeError) {
      // Nothing changed: ask for a type in the details form below.
      errors = { type: 'Add at least one type before publishing. Choose it below, then save.' };
    } else if (!(err instanceof VersionConflict)) throw err;
    else {
      general.push(
        'Someone else changed this event while you were working on it. The latest version is shown below. Check it, then make your change again.',
      );
      detail = (await getAdminEvent(id))!;
      version = detail.event.version;
      if (step !== 'save') values = recordToForm(detail.event);
    }
  }
}

const e = detail.event;
const when = describeWhen(e);
const published = e.status === 'approved' || e.status === 'cancelled';
const STATUS: Record<string, string> = {
  pending: 'Waiting for review',
  approved: 'Published',
  rejected: 'Rejected',
  cancelled: 'Published as cancelled',
};
---

<AdminLayout
  hasErrors={Object.keys(errors).length > 0 || general.length > 0}
  title={view === 'reject' ? `Reject: ${e.title}` : e.title}
  admin={guard.admin}
  current="queue"
  breadcrumbs={view === 'reject' ? [{ href: `/admin/events/${e.id}`, label: e.title }] : []}
>
  {view === 'reject' ? (
    <>
      <div class="page-head">
        <h1 tabindex="-1" data-focus-on-load>
          Reject this event?
        </h1>
        <p class="lede">
          "<span lang={e.lang}>{e.title}</span>" won't be published.
          {detail.submitter?.email ? ' We will email the person who added it, with your reason.' : ''}
        </p>
      </div>
      {restored && (
        <div class="notice notice--important" role="status" tabindex="-1" data-focus-on-load>
          <p>
            You were signed out while rejecting this event, so we kept your reason. Check it, then choose "Reject
            event".
          </p>
        </div>
      )}
      <ErrorSummary errors={errors} />
      <form method="post" class="flow" novalidate>
        <input type="hidden" name="version" value={version} />
        <Field
          name="reason"
          label="Reason"
          type="textarea"
          rows={4}
          value={rejectReason}
          error={errors.reason}
          required
          hint="Write it for the person who added the event, in plain language."
          maxlength={2000}
        />
        <div class="button-row">
          <button type="submit" name="step" value="reject" class="button--danger">
            Reject event
          </button>
          <a class="link-standalone" href={`/admin/events/${e.id}`}>
            Go back without rejecting
          </a>
        </div>
      </form>
    </>
  ) : (
    <>
      <div class="page-head">
        <h1 lang={e.lang}>{e.title}</h1>
        <p class="lede">
          {STATUS[e.status]}. {when.date}, <Abbreviated text={when.time} />.
        </p>
      </div>

      <ErrorSummary
        errors={errors}
        general={general}
        targets={{ timing: 'f-timing', format: 'f-format', price: 'f-price', access: 'f-access' }}
      />
      {saved && (
        <div class="notice notice--success" role="status" tabindex="-1" data-focus-on-load>
          <p>Saved.</p>
        </div>
      )}
      {restoredStep === 'save' && (
        <div class="notice notice--important" role="status" tabindex="-1" data-focus-on-load>
          <p>
            You were signed out while saving, so we kept your changes. They're in the form below. Check them, then
            choose "Save changes".
          </p>
        </div>
      )}

      <section aria-labelledby="about" class="flow">
        <h2 id="about">About this event</h2>
        <dl class="details-list">
          <dt>Status</dt>
          <dd>
            {STATUS[e.status]}
            {published && (
              <>
                {' '}
                (<a href={`/events/${e.slug}`}>see it on the site</a>)
              </>
            )}
          </dd>
          <dt>Came from</dt>
          <dd>{e.source === 'form' ? 'The submit form' : `Import: ${detail.sourceName ?? e.source}`}</dd>
          <dt>Added by</dt>
          <dd>
            {detail.submitter?.email
              ? `${detail.submitter.name ? `${detail.submitter.name}, ` : ''}${detail.submitter.email}`
              : 'Not known'}
          </dd>
          <dt>Flags</dt>
          <dd>{e.flags.length ? e.flags.join(', ').replace(/_/g, ' ') : 'None'}</dd>
          {detail.submitter?.rejection_reason && e.status === 'rejected' && (
            <>
              <dt>Rejected because</dt>
              <dd>{detail.submitter.rejection_reason}</dd>
            </>
          )}
        </dl>
        {detail.duplicates.length > 0 && (
          <div class="notice notice--important flow-tight">
            <h3>This might be a duplicate of</h3>
            <ul>
              {detail.duplicates.map((d) => (
                <li>
                  <a href={`/admin/events/${d.id}`}>{d.title}</a>, {d.local_start_date} ({STATUS[d.status] ?? d.status},{' '}
                  {Math.round(d.score * 100)}% similar name)
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>

      {e.pending_changes && Object.keys(e.pending_changes).length > 0 && (
        <section aria-labelledby="changes" class="notice notice--important flow">
          <h2 id="changes">The source changed this event</h2>
          <p>The public page still shows the old details. Accept the changes to publish them.</p>
          <div class="table-scroll">
            <table class="data-table">
              <caption class="visually-hidden">Changes from the source</caption>
              <thead>
                <tr>
                  <th scope="col">Detail</th>
                  <th scope="col">Now</th>
                  <th scope="col">Source says</th>
                </tr>
              </thead>
              <tbody>
                {Object.entries(e.pending_changes).map(([k, v]) => (
                  <tr>
                    <th scope="row">{k.replace(/_/g, ' ')}</th>
                    <td>{String((e as unknown as Record<string, unknown>)[k] ?? 'Not set')}</td>
                    <td>{String(v ?? 'Not set')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <form method="post" class="button-row">
            <input type="hidden" name="version" value={version} />
            <button type="submit" name="step" value="accept-changes">
              Accept the changes
            </button>
            <button type="submit" name="step" value="discard-changes" class="button--secondary">
              Keep the current details
            </button>
          </form>
        </section>
      )}
      {e.flags.includes('cancel_requested') && e.status === 'approved' && (
        <div class="notice notice--important flow-tight">
          <p>
            <strong>The source says this event is cancelled.</strong> Check, then choose "Mark as cancelled" below.
          </p>
        </div>
      )}

      <section aria-labelledby="decide" class="flow">
        <h2 id="decide">Decide</h2>
        {e.status === 'pending' && (
          <div class="notice flow-tight">
            <p>Before you publish, check that:</p>
            <ul>
              <li>it's about accessibility</li>
              <li>the summary explains the event in plain language, without jargon</li>
              <li>the date, time and time zone look right</li>
              <li>the website link works</li>
            </ul>
          </div>
        )}
        <form method="post" class="button-row">
          <input type="hidden" name="version" value={version} />
          {(e.status === 'pending' || e.status === 'rejected') && (
            <button type="submit" name="step" value="approve">
              Publish
            </button>
          )}
          {e.status === 'pending' && (
            <button type="submit" name="step" value="reject-check" class="button--secondary">
              Reject
            </button>
          )}
          {e.status === 'approved' && (
            <button type="submit" name="step" value="unpublish" class="button--secondary">
              Take off the site
            </button>
          )}
          {e.status === 'approved' && (
            <button type="submit" name="step" value="cancel" class="button--secondary">
              Mark as cancelled
            </button>
          )}
          {e.status === 'cancelled' && (
            <button type="submit" name="step" value="restore" class="button--secondary">
              Publish again (not cancelled)
            </button>
          )}
        </form>
        {e.status === 'approved' && (
          <p class="hint">
            Taking it off the site puts it back in the review list. You can publish it again at any time.
          </p>
        )}
      </section>

      <section aria-labelledby="edit">
        <h2 id="edit">Edit details</h2>
        <form method="post" class="flow" novalidate>
          <input type="hidden" name="version" value={version} />
          <EventFields values={values} errors={errors} />
          <div class="button-row">
            <button type="submit" name="step" value="save">
              Save changes
            </button>
          </div>
        </form>
      </section>
    </>
  )}
</AdminLayout>
