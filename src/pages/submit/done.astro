---
import BaseLayout from '../../layouts/BaseLayout.astro';
const already = Astro.url.searchParams.get('already') === '1';
---

<BaseLayout
  title="Event sent for review"
  nav="submit"
  breadcrumbs={[{ href: '/submit', label: 'Add an event' }]}
  crumbLabel="Sent"
>
  <div class="notice notice--success flow-tight" tabindex="-1" data-focus-on-load>
    <h1>{already ? 'You have already sent this event' : 'Event sent for review'}</h1>
    <p>
      {already
        ? "We already have this event, so we didn't add it again."
        : "Thank you. We've emailed you a confirmation."}
    </p>
  </div>
  <div class="flow">
    <h2>What happens next</h2>
    <p>
      A person checks the event, usually within 2 working days. We'll email you when it's published, or if there's a
      problem.
    </p>
    <p>
      <a class="link-standalone" href="/submit">
        Add another event
      </a>
    </p>
    <p>
      <a class="link-standalone" href="/">
        Go to the list of events
      </a>
    </p>
  </div>
</BaseLayout>
